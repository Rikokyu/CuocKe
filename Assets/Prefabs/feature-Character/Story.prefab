  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 34af4cdbad9091240be3a762aae62b0d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GardenFlowStory
  questManager: {fileID: 0}
  choreQuest: {fileID: 11400000, guid: b97efb725b0ba6442b9476056843122b, type: 2}
  feedQuest: {fileID: 11400000, guid: b30866a93c6442f41ad09cd261ac4ba6, type: 2}
  napQuest: {fileID: 11400000, guid: 70cfa0e8ed6be7c40895453e9e8536c0, type: 2}
  grandfather: {fileID: 0}
  grandmother: {fileID: 0}
  dialogue: {fileID: 0}
  banner: {fileID: 0}
  feedingSpot: {fileID: 0}
  offerBanner: "\xD4ng \u0111ang g\u1ECDi: ra g\u1EB7p \xF4ng, \xF4ng c\xF3 vi\u1EC7c
    nh\u1EDD."
  acceptFeedLabel: "V\xE2ng, \u0111\u1EC3 ch\xE1u cho g\xE0 \u0103n"
  offerLines:
  - "Ch\xE1u t\u01B0\u1EDBi rau xong r\u1ED3i h\u1EA3? Gi\u1ECFi l\u1EAFm!"
  - "Gi\u1EDD gi\xFAp \xF4ng cho con g\xE0 \u0103n nh\xE9. Ch\xE1u h\xE1i \xEDt rau
    ngo\xE0i v\u01B0\u1EDDn r\u1ED3i \u0111\u1EB7t l\xEAn c\xE1i \u0111\u0129a cho
    n\xF3 \u0103n."
  graOfferLines:
  - "\xD4ng \u0111ang t\xECm ch\xE1u \u0111\u1EA5y, ra g\u1EB7p \xF4ng \u0111i."
  feedRemindLines:
  - "Ch\xE1u h\xE1i rau ngo\xE0i v\u01B0\u1EDDn r\u1ED3i \u0111\u1EB7t l\xEAn c\xE1i
    \u0111\u0129a cho g\xE0 \u0103n nh\xE9."
  eatingLines:
  - "Ch\xE1u \u0111\u1EC3 con g\xE0 \u0103n cho xong \u0111\xE3. Tr\u1ED9n c\u1EA3
    b\u1ED9t v\xE0o r\u1ED3i, n\xF3 \u0103n xong l\xE0 ch\xE1u ngh\u1EC9 ng\u01A1i
    \u0111\u01B0\u1EE3c."
  branRemindLines:
  - "N\xE0y ch\xE1u! Nh\u1EDB l\u1EA5y th\xEAm b\u1ED9t c\xE1m trong c\xE1i h\u0169
    ngo\xE0i v\u01B0\u1EDDn, tr\u1ED9n v\xE0o rau cho g\xE0 \u0103n nh\xE9!"
  napAskLabel: "Xin ph\xE9p \u0111i ng\u1EE7 tr\u01B0a"
  napAskLines:
  - "\u01A0, ch\xE1u c\xF3 chuy\u1EC7n g\xEC th\u1EBF?"
  napThanksLabel: "D\u1EA1, ch\xE1u c\u1EA3m \u01A1n \xF4ng"
  napSayLines:
  - "[Player] Ch\u1EAFc ch\xE1u xin ph\xE9p v\xF4 ng\u1EE7 tr\u01B0a 1 ch\xFAt cho
    kh\u1ECFe \u1EA1"
  - "Th\u1EBF v\xE0o gi\u01B0\u1EDDng trong ph\xF2ng m\xE0 ng\u1EE7"
  napGrandmaLines:
  - "Ch\xE1u xin ph\xE9p \xF4ng \u0111i, \xF4ng \u1EDF ngo\xE0i s\xE2n kia."
  napAllowedLines:
  - "Ch\xE1u v\xE0o gi\u01B0\u1EDDng trong ph\xF2ng m\xE0 ng\u1EE7 \u0111i."
  feedBanner: "Nh\u1EADn nhi\u1EC7m v\u1EE5: cho g\xE0 \u0103n."
  napBanner: "G\xE0 \u0103n xong r\u1ED3i. Gi\u1EDD xin ph\xE9p \xF4ng b\xE0 \u0111i
    ng\u1EE7 tr\u01B0a."
  allowedBanner: "\xD4ng \u0111\xE3 \u0111\u1ED3ng \xFD. V\xE0o gi\u01B0\u1EDDng
    trong ph\xF2ng \u0111\u1EC3 ng\u1EE7."
