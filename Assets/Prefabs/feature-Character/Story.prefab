  askButtonLabel: "\u0110i t\xECm con g\xE0"
  askGrandfatherLines:
  - "\u01A0 v\xE3i \xF2, k\xEAu ng\u1EE7 tr\u01B0a 1 ch\xFAt m\xE0 qua h\xF4m sau
    r\u1ED3i \u0111\xF3 nh\xF3c"
  - "[Player] Ch\u1EAFc ch\xE1u h\u01A1i m\u1EC7t qu\xE1 "
  - "[Player] \xD4ng \u01A1i, s\xE1ng nay ch\xE1u d\u1EADy kh\xF4ng th\u1EA5y con
    g\xE0 \u0111\xE2u c\u1EA3. \xD4ng c\xF3 th\u1EA5y n\xF3 kh\xF4ng \u1EA1?"
  - "C\xF3, \xF4ng th\u1EA5y n\xF3 ch\u1EA1y ra kh\u1ECFi s\xE2n t\u1EEB t\u1EDD
    m\u1EDD s\xE1ng, tr\xF4ng kho\u1EBB re. H\xECnh nh\u01B0 n\xF3 ch\u1EA1y v\u1EC1
    ph\xEDa khu hu\u1EA5n luy\u1EC7n."
  - "Ch\xE1u ra \u0111\xF3 t\xECm th\u1EED xem."
  askGrandmotherLines:
  - "Deadline nhi\u1EC1u l\u1EAFm hay sao m\xE0 ng\u1EE7 n\u01B0\u1EDBng th\u1EBF
    con "
  - "[Player] B\xE0 \u01A1i, b\xE0 c\xF3 th\u1EA5y con g\xE0 c\u1EE7a ch\xE1u \u0111\xE2u
    kh\xF4ng \u1EA1? S\xE1ng nay ch\xE1u d\u1EADy l\xE0 m\u1EA5t ti\xEAu r\u1ED3i."
  - "B\xE0 d\u1EADy t\u01B0\u1EDBi rau \u0111\xE3 kh\xF4ng th\u1EA5y n\xF3. Nghe
    ng\u01B0\u1EDDi ta b\u1EA3o th\u1EA5y n\xF3 ch\u1EA1y v\u1EC1 ph\xEDa khu hu\u1EA5n
    luy\u1EC7n \u0111\u1EA5y."
  - "Ch\xE1u ra \u0111\xF3 xem th\u1EED \u0111i."
  remindLines:
  - "Ch\xE1u ra khu hu\u1EA5n luy\u1EC7n t\xECm con g\xE0 \u0111i, ch\u1EAFc n\xF3
    \u1EDF \u0111\xF3."
  remindFoundLines:
  - "Th\u1EA5y n\xF3 r\u1ED3i th\xEC \u0111\u1EBFn g\u1EA7n, d\u1EABn n\xF3 v\u1EC1
    nh\xE9."
  searchMessage: "\u0110\xE3 nh\u1EADn nhi\u1EC7m v\u1EE5: T\xECm con g\xE0 \u1EDF
    khu hu\u1EA5n luy\u1EC7n."
  discoveryCaption: "C\xE1i h\xE9o l\xE1 g\xEC d\u1EADy fen. Con g\xE0 nh\xECn quen
    v\u1EADy"
  foundHint: "\u0110\u1EBFn g\u1EA7n con g\xE0 v\xE0 nh\u1EA5n E \u0111\u1EC3 nh\u1EADn
    l\u1EA1i n\xF3."
