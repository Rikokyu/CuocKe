--- !u!114 &9187836858506610103
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7382704050317328008}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 79ee516a636f1134c95c714ff842f65c, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ZoroReunionStory
  questManager: {fileID: 0}
  tournamentQuest: {fileID: 11400000, guid: 1989041d0b8b83f4aa09da3b56507527, type: 2}
  restQuest: {fileID: 11400000, guid: c4af531132f84e742954bcbd460dc6c9, type: 2}
  findQuest: {fileID: 11400000, guid: 6705a48aaadd3834f8c91c79f1c7725d, type: 2}
  chicken: {fileID: 0}
  zoro: {fileID: 0}
  watchSpot: {fileID: 2852387532289613315}
  player: {fileID: 0}
  bed: {fileID: 4137443020828603841}
  grandfather: {fileID: 0}
  grandmother: {fileID: 0}
  dialogue: {fileID: 0}
  banner: {fileID: 0}
  viewCamera: {fileID: 0}
  showOnSearch:
  - {fileID: 0}
  hideOnSearch:
  - {fileID: 0}
  discoverDistance: 22
  viewHalfAngle: 60
  talkDistance: 5.5
  zoroSpeaker: Zoro
  restMessage: "H\u1EA1 c\u1EA3 EndminGaGa l\u1EABn Ch\xFA V\u1ECBt nh\u1EA3y r\u1ED3i!
    V\u1EC1 nh\xE0 \xF4ng b\xE0 n\u1EB1m ng\u1EE7 m\u1ED9t gi\u1EA5c cho kho\u1EBB."
  wakeMessage: "S\xE1ng d\u1EADy... con g\xE0 l\u1EA1i bi\u1EBFn m\u1EA5t r\u1ED3i!
    H\u1ECFi \xF4ng b\xE0 xem sao."
  askButtonLabel: "\u0110i t\xECm con g\xE0"
  askGrandfatherLines:
  - "[Player] \xD4ng \u01A1i, s\xE1ng d\u1EADy ch\xE1u l\u1EA1i kh\xF4ng th\u1EA5y
    con g\xE0 \u0111\xE2u c\u1EA3. \xD4ng c\xF3 th\u1EA5y n\xF3 kh\xF4ng \u1EA1?"
  - "N\xF3 \u0111i theo th\u1EB1ng t\xF3c xanh l\xE1 r\u1ED3i!"
  - "[Player] \u01A0, th\u1EB1ng m\xF9 \u0111\u01B0\u1EDDng m\xE0?"
  askGrandmotherLines:
  - "[Player] B\xE0 \u01A1i, con g\xE0 c\u1EE7a ch\xE1u l\u1EA1i bi\u1EBFn m\u1EA5t
    r\u1ED3i, b\xE0 c\xF3 th\u1EA5y n\xF3 \u0111\xE2u kh\xF4ng \u1EA1?"
  - "N\xF3 \u0111i theo th\u1EB1ng t\xF3c xanh l\xE1 r\u1ED3i!"
  - "[Player] \u01A0, th\u1EB1ng m\xF9 \u0111\u01B0\u1EDDng m\xE0?"
  restHintLines:
  - "\u0110\xE1nh xong hai tr\u1EADn m\u1EC7t l\u1EAFm r\u1ED3i h\u1EA3 ch\xE1u?
    V\xE0o nh\xE0 n\u1EB1m l\xEAn gi\u01B0\u1EDDng ng\u1EE7 m\u1ED9t gi\u1EA5c cho
    l\u1EA1i s\u1EE9c \u0111i."
  remindLines:
  - "Con g\xE0 \u0111i theo th\u1EB1ng t\xF3c xanh l\xE1 \u0111\u1EA5y. Ch\xE1u ra
    t\xECm n\xF3 \u0111i, ch\u1EAFc n\xF3 \u0111\u1EE9ng \u0111\xE2u \u0111\xF3 g\u1EA7n
    th\u1EB1ng \u0111\xF3 th\xF4i."
  remindFoundLines:
  - "Th\u1EA5y n\xF3 r\u1ED3i th\xEC l\u1EA1i g\u1EA7n, d\u1EAFt n\xF3 v\u1EC1 nh\xE9."
  searchMessage: "\u0110\xE3 nh\u1EADn nhi\u1EC7m v\u1EE5: T\xECm con g\xE0 \u0111ang
    \u0111i theo Zoro t\xF3c xanh l\xE1."
  foundHint: "Con g\xE0 kia r\u1ED3i! N\xF3 \u0111\u1EE9ng t\u1EEB xa nh\xECn Zoro.
    L\u1EA1i g\u1EA7n n\xF3 \u0111i."
  reunionLines:
  - "[Player] Con g\xE0 \u0111\xE2y r\u1ED3i! M\xE0y \u0111\u1EE9ng nh\xECn \xF4ng
    t\xF3c xanh l\xE1 kia t\u1EEB n\xE3y \u0111\u1EBFn gi\u1EDD \xE0?"
  - "H\u1EEDm? Con g\xE0 c\u1EE7a ch\xFA m\xE0y \xE0? N\xF3 l\u1EBDo \u0111\u1EBDo
    theo t\xF4i t\u1EEB t\u1EDD m\u1EDD s\xE1ng \u0111\u1EA5y."
  - "[Player] H\xE8n g\xEC... M\xE0 sao \xF4ng \u0111\u1EE9ng \u0111\xE2y? Khu hu\u1EA5n
    luy\u1EC7n \u0111\xE2u c\xF3 xa."
  - "T\xF4i \u0111\xE2u c\xF3 l\u1EA1c! Ch\u1EC9 l\xE0 con \u0111\u01B0\u1EDDng n\xF3
    c\u1EE9 t\u1EF1 \u0111\u1ED5i h\u01B0\u1EDBng th\xF4i."
  - "Nh\u01B0ng con g\xE0 n\xE0y th\xFA v\u1ECB l\u1EAFm. N\xF3 \u0111\u1EE9ng xem
    t\xF4i quay c\u01A1n l\u1ED1c c\u1EA3 bu\u1ED5i m\xE0 kh\xF4ng ch\u1EDBp m\u1EAFt."
  - "C\u01A1n l\u1ED1c \u0111\xF3 g\u1ECDi l\xE0 Hurricane. Gi\u1EDD n\xF3 nh\u1EDB
    h\u1EBFt r\u1ED3i. D\u1EAFt n\xF3 v\u1EC1 \u0111i, r\u1ED3i cho th\u1EB1ng b\u1EA1n
    c\u1EE7a ch\xFA m\xE0y th\u1EA5y."
  - "[Player] Hurricane \xE1? G\xE0 m\xECnh h\u1ECDc l\u1ECFm \u0111\u01B0\u1EE3c
    tuy\u1EC7t chi\xEAu r\u1ED3i sao?"
  unlockMessage: "Con g\xE0 \u0111\xE3 h\u1ECDc \u0111\u01B0\u1EE3c k\u1EF9 n\u0103ng
    HURRICANE! D\xF9ng n\xF3 trong tr\u1EADn t\xE1i \u0111\u1EA5u cu\u1ED1i c\xF9ng."
