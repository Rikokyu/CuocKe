--- !u!114 &7041948373682257183
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 879074537327665802}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e58a7e9dc65101e4289489f43f588867, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChickenTransformationTrigger
  questManager: {fileID: 1520950855935456613}
  dialogue: {fileID: 0}
  banner: {fileID: 0}
  choreQuest: {fileID: 11400000, guid: b97efb725b0ba6442b9476056843122b, type: 2}
  gardenQuest: {fileID: 11400000, guid: b30866a93c6442f41ad09cd261ac4ba6, type: 2}
  nextQuest: {fileID: 11400000, guid: 98783775d5747574381b5027f57adebb, type: 2}
  chicken: {fileID: 0}
  gardenOfferLines:
  - "C\u1EA3m \u01A1n ch\xE1u nh\xE9! Ch\xE1u gi\xFAp b\xE0 th\xEAm ch\xFAt n\u1EEFa
    l\xE0 xong."
  - "Bao ph\xE2n b\xF3n b\xE0 \u0111\u1EC3 \u1EDF g\xF3c s\xE2n. Ch\xE1u b\xF3n cho
    lu\u1ED1ng rau, h\xE1i rau, r\u1ED3i \u0111\u1EB7t rau \u1EDF ch\u1ED7 c\xE1i
    \u0111\u0129a cho g\xE0 \u0103n."
  - "Xong vi\u1EC7c th\xEC v\xE0o nh\xE0 \u0111i ng\u1EE7 cho kho\u1EBB nh\xE9."
  recoveredLines:
  - "[Player] Nh\xECn tr\xF4ng l\u1EF1c h\u01A1n h\u1EB3n nh\u1EC9, Hay l\xE0 m\xECnh
    th\u1EED \u0111\u1EA5u l\u1EA1i v\u1EDBi th\u1EB1ng b\u1EA1n th\u1EED xem sao"
  - "[Player] M\xE0 b\xE0 nh\u1EDD mang g\xF3i h\xE0ng c\u1EA1nh nh\xE0 qua cho th\u1EB1ng
    b\u1EA1n. Ti\u1EC7n \u0111\u01B0\u1EDDng, qua \u0111\xF3 lu\xF4n!"
  transformedMessage: "S\xE1ng d\u1EADy, con g\xE0 \u0111\xE3 to kho\u1EBB h\u1EB3n
    ra! Khu hu\u1EA5n luy\u1EC7n \u0111\xE3 m\u1EDF."
  recoveredMessage: "\u0110\xE3 nh\u1EADn l\u1EA1i g\xE0! N\xF3 to kho\u1EBB h\u1EB3n
    ra. Khu hu\u1EA5n luy\u1EC7n \u0111\xE3 m\u1EDF."
  scaleMultiplier: 1.35
  tint: {r: 0.85, g: 0.25, b: 0.2, a: 1}
  tintStrength: 0.4
