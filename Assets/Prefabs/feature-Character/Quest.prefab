MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2870945863619485262}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 6d41fa422de11be46be9df4fbe6dfc26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::LotteryRedeem
  mrBeast: {fileID: 0}
  lotteryTicket: {fileID: 11400000, guid: a0b7e29ec3c82414a9790762da7c2656, type: 2}
  wallet: {fileID: 0}
  dialogue: {fileID: 0}
  banner: {fileID: 0}
  prizePerTicket: 500
  speakerName: "D\xE2n l\xE0ng"
  offerLines:
  - "\u1ED2, c\u1EADu c\xF3 {0} v\xE9 s\u1ED1 trong t\xFAi \u0111\u1EA5y! Mu\u1ED1n
    \u0111\u1ED5i th\u01B0\u1EDFng kh\xF4ng?"
  redeemLabel: "\u0110\u1ED5i th\u01B0\u1EDFng"
  talkLabel: "N\xF3i chuy\u1EC7n kh\xE1c"
  guessLines:
  - "Lu\u1EADt \u0111\u01A1n gi\u1EA3n th\xF4i: t\xF4i quay m\u1ED9t con s\u1ED1.
    C\u1EADu \u0111o\xE1n s\u1ED1 \u0111\xF3 CH\u1EB4N hay L\u1EBA."
  - "\u0110o\xE1n \u0111\xFAng, {0} v\xE9 c\u1EE7a c\u1EADu th\u01B0\u1EDFng {1}
    VN\u0110. \u0110o\xE1n sai th\xEC m\u1EA5t v\xE9. C\u1EADu ch\u1ECDn g\xEC n\xE0o?"
  evenLabel: "Ch\u1EB5n"
  oddLabel: "L\u1EBB"
  winLines:
  - "Quay s\u1ED1... ra con s\u1ED1 {2}! S\u1ED1 {2} l\xE0 s\u1ED1 {3}."
  - "Ch\xFAc m\u1EEBng, c\u1EADu \u0111o\xE1n \u0111\xFAng! Nh\u1EADn {1} VN\u0110
    nh\xE9!"
  loseLines:
  - "Quay s\u1ED1... ra con s\u1ED1 {2}! S\u1ED1 {2} l\xE0 s\u1ED1 {3}."
  - "Ti\u1EBFc qu\xE1, c\u1EADu \u0111o\xE1n sai r\u1ED3i. L\u1EA7n sau may m\u1EAFn
    h\u01A1n nh\xE9!"
