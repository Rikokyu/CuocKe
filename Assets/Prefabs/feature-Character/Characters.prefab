  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestNPC
  npcName: "B\xE0"
  quest: {fileID: 11400000, guid: b97efb725b0ba6442b9476056843122b, type: 2}
  additionalQuests:
  - {fileID: 11400000, guid: 9fdce12d520833149b877b8c24d6a202, type: 2}
  interactionDistance: 4
  interactKey: 101
  promptText: "Nh\u1EA5n E \u0111\u1EC3 n\xF3i chuy\u1EC7n v\u1EDBi B\xE0 2 3"
  requireFirstBattleLoss: 1
  requiredCompletedQuest: {fileID: 0}
  startedByStory:
  - {fileID: 11400000, guid: 9fdce12d520833149b877b8c24d6a202, type: 2}
  storyPayAfterCompleted: {fileID: 11400000, guid: 67499589fd8c04f499abc755095037db, type: 2}
  payLaterLines:
  - "Ch\xE1u giao h\xE0ng xong r\u1ED3i \xE0? Gi\u1ECFi l\u1EAFm! Nh\u01B0ng lo xong
    chuy\u1EC7n v\u1EDBi th\u1EB1ng b\u1EA1n \u0111\xE3, r\u1ED3i quay l\u1EA1i \u0111\xE2y
    b\xE0 tr\u1EA3 c\xF4ng nh\xE9."
  alsoRequiredCompletedQuests: []
  player: {fileID: 0}
  modelRoot: {fileID: 0}
  questManager: {fileID: 0}
  dialogue: {fileID: 0}
  prompt: {fileID: 0}
  offerLines:
  - "Ch\xE1u c\u1EA7n \xEDt ti\u1EC1n \xE0? Ch\u1EE9 l\xE0m IT ki\u1EC3u g\xEC m\xE0
    v\u1EC1 kh\xF4ng c\xF3 ti\u1EC1n th\u1EBF n\xE0y."
  - "Th\u1EED \u0111i nh\u1EB7t ve chai quanh l\xE0ng \u0111i. \u0110\u1EE7 {1} m\xF3n
    th\xEC quay l\u1EA1i \u0111\xE2y, t\xF4i s\u1EBD tr\u1EA3 c\xF4ng cho c\u1EADu."
  activeLines:
  - "C\u1EADu m\u1EDBi nh\u1EB7t \u0111\u01B0\u1EE3c {0}/{1} m\xF3n th\xF4i. \u0110i
    nh\u1EB7t th\xEAm ve chai quanh l\xE0ng \u0111i!"
  readyLines:
  - "\u0110\u1EE7 {1} m\xF3n r\u1ED3i \xE0? Gi\u1ECFi l\u1EAFm! Ti\u1EC1n c\xF4ng
    c\u1EE7a c\u1EADu l\xE0 {2} VN\u0110."
  completedLines:
  - "C\u1EA3m \u01A1n c\u1EADu nh\xE9! C\u1EA7m ti\u1EC1n \u0111\xF3 m\xE0 lo cho
    con g\xE0 \u0111i."
  idleLines:
  - "Ch\xE1u v\u1EC1 r\u1ED3i \xE0, V\u1EC1 \u0111\xE2y th\u0103m \xF4ng b\xE0 lu\xF4n
    c\u01A1 \u0111\u1EA5y."
  - "Xu\u1ED1ng ch\xE0o \xF4ng \u0111i ch\xE1u, \xD4ng \u0111ang \u1EDF sau nh\xE0
    \u0111\u1EA5y\n"
  acceptLabel: "Nh\u1EADn nhi\u1EC7m v\u1EE5"
  claimLabel: "Nh\u1EADn ti\u1EC1n c\xF4ng (+{2} VN\u0110)"
