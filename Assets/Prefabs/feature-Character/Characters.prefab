  questRescue: {fileID: 11400000, guid: bc723f5358c8b9d42b39cffae239a86d, type: 2}
  chicken: {fileID: 0}
  endgameVideo: {fileID: 32900000, guid: 7bde2e7ccc3aa6f42b16d6fef073501f, type: 3}
  agreeCookLabel: "\u0110\u1ED3ng \xFD"
  agreeCookLines:
  - "[Player] Li\u1EC1n lu\xF4n \xF4ng anh, t\xF4i \u0111\xF3i r\u1ED3i"
  - "Th\u1EB1ng n\xE0y l\xE1o"
  agreeContinueLabel: "Ti\u1EBFp t\u1EE5c"
  endgamePrepareTimeout: 8
  endgamePlaybackSlack: 4
  endgameVolume: 1
  deliveryQuest: {fileID: 11400000, guid: 9fdce12d520833149b877b8c24d6a202, type: 2}
  grandmother: {fileID: 1222772470150012517}
  grandmaSpeaker: "B\xE0"
  acceptTaskLabel: "Nh\u1EADn nhi\u1EC7m v\u1EE5"
  grandmaTaskLines:
  - "Ch\xE1u \u01A1i, khoan \u0111\xE3! B\xE0 c\xF3 vi\u1EC7c nh\u1EDD ch\xE1u."
  - "G\xF3i h\xE0ng \u0111\u1EC3 c\u1EA1nh nh\xE0 \xF4ng b\xE0 \u0111\u1EA5y. Ch\xE1u
    mang qua cho th\u1EB1ng b\u1EA1n thu\u1EDF nh\u1ECF c\u1EE7a ch\xE1u gi\xFAp
    b\xE0 nh\xE9."
  - "Giao xong th\xEC quay l\u1EA1i g\u1EB7p b\xE0, b\xE0 tr\u1EA3 {0} VN\u0110 ti\u1EC1n
    c\xF4ng."
  greetLines:
  - "A, ch\xE1u v\u1EC1 r\u1ED3i \u0111\u1EA5y \xE0! L\xE2u l\u1EAFm m\u1EDBi th\u1EA5y
    m\u1EB7t."
  - "\u0110\u1EC3 \xF4ng m\u1EEBng th\u1ECBt con g\xE0 cho ch\xFAng ta c\xF9ng \u0103n
    nh\xE9!"
  keepButtonLabel: "Xin \xF4ng gi\u1EEF l\u1EA1i con g\xE0"
  agreeLines:
  - "Th\xF4i \u0111\u01B0\u1EE3c, ch\xE1u \u0111\xE3 xin v\u1EADy th\xEC \xF4ng chi\u1EC1u
    ch\xE1u. Con g\xE0 l\xE0 c\u1EE7a ch\xE1u r\u1ED3i \u0111\u1EA5y!"
  - "N\xF3 \u0111ang t\u1EC9nh d\u1EADy k\xECa. Ch\u0103m n\xF3 cho t\u1EED t\u1EBF
    nh\xE9."
  idleLines:
  - "Th\xF4i \u0111\u01B0\u1EE3c, ch\xE1u \u0111\xE3 xin v\u1EADy th\xEC \xF4ng chi\u1EC1u
    ch\xE1u, gi\u1EEF l\u1EA5y m\xE0 nu\xF4i."
  - "Con g\xE0 \u0111\xF3 \xF4ng th\u1EA5y l\u1EA1 l\u1EAFm, ch\xE1u ch\u0103m s\xF3c
    n\xF3 c\u1EA9n th\u1EADn nh\xE9."
