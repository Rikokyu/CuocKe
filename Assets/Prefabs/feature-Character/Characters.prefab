--- !u!114 &8596535543713313370
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2177119706131696965}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 709618d64535d294484833c35ecc702a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChildhoodFriendBattleTaunt
  interactionDistance: 4
  interactKey: 101
  promptText: "Nh\u1EA5n E \u0111\u1EC3 n\xF3i chuy\u1EC7n v\u1EDBi B\u1EA1n th\xE2n
    (L\u1ED1p)"
  player: {fileID: 0}
  dialogue: {fileID: 0}
  prompt: {fileID: 0}
  questManager: {fileID: 0}
  questBattle: {fileID: 11400000, guid: 67499589fd8c04f499abc755095037db, type: 2}
  deliveryTarget: {fileID: 0}
  deliveryQuest: {fileID: 11400000, guid: 9fdce12d520833149b877b8c24d6a202, type: 2}
  needDeliveryLines:
  - "\u01A0, th\u1EB1ng IT v\u1EC1 l\xE0ng r\u1ED3i \xE0? M\xE0 sao tay kh\xF4ng
    th\u1EBF? B\xE0 m\xE0y b\u1EA3o g\u1EEDi g\xF3i h\xE0ng cho tao, \u0111\xE2u
    r\u1ED3i?"
  thanksLines:
  - "\u1ED2, g\xF3i h\xE0ng c\u1EE7a b\xE0 m\xE0y g\u1EEDi \u0111\u1EA5y h\u1EA3?
    C\u1EA3m \u01A1n nh\xE9, \u0111\xFAng c\xE1i tao \u0111ang ch\u1EDD!"
  thanksDelaySeconds: 1
  thanksAutoDistance: 6
  tauntDelaySeconds: 2.5
  challengeLines:
  - "\u01A0, th\u1EB1ng IT v\u1EC1 l\xE0ng r\u1ED3i \xE0? L\xE2u l\u1EAFm kh\xF4ng
    g\u1EB7p!"
  - "Tao m\u1EDBi quen nh\u1ECF kia xinh l\u1EAFm, c\xF3 c\u1EA7n tao gi\u1EDBi thi\u1EC7u
    cho kh\xF4ng"
  - "\u1EE6a m\xE0 con g\xE0 c\u1EE7a m\xECnh nh\xECn c\u0169ng ch\u1EAFc th\u1ECBt
    \u0111\u1EA5y"
  - "Th\u1EED s\u1EE9c v\u1EDBi g\xE0 c\u1EE7a tao xem sao? \u0110\u1EC3 l\xFAc n\xE0o
    r\u1EA3nh m\xECnh \u0111\u1EA5u m\u1ED9t tr\u1EADn!"
  acceptLabel: "Nh\u1EADn l\u1EDDi th\xE1ch \u0111\u1EA5u"
  needChickenLines:
  - "\u01A0, g\xE0 c\u1EE7a m\xE0y \u0111\xE2u? D\u1EAFt n\xF3 theo r\u1ED3i h\u1EB5ng
    n\xF3i chuy\u1EC7n th\xE1ch \u0111\u1EA5u!"
  fightingLines:
  - "\u0110ang \u0111\u1EA5u r\u1ED3i, nh\xECn \u0111i \u0111\xE2u \u0111\u1EA5y?!"
  afterLossLines:
  - "Hahaha, thua r\u1ED3i \u0111\xF3! B\u1EEFa n\xE0o t\xE1i \u0111\u1EA5u kh\xF4ng? "
  - "Kh\xF4ng d\xE1m ch\u01A1i l\xE0 d\u1EDF r\u1ED3i. Ph\u1EA3i ch\u01A1i m\u1EA1nh
    l\xEAn m\u1EDBi c\xF3 ng\u01B0\u1EDDi y\xEAu nh\u01B0 tao Hahahaa "
  - "M\xC0Y S\u1EE2 \xC0 "
  idleLines:
  - "G\xE0 m\xE0y c\xF2n y\u1EBFu l\u1EAFm. V\u1EC1 gi\xFAp \xF4ng b\xE0 \u0111i
    \u0111\xE3, r\u1ED3i t\xEDnh chuy\u1EC7n t\xE1i \u0111\u1EA5u. Tao ch\u1EDD \u0111\u1EA5y."
  playerSpeakerName: "T\xF4i"
  playerReplyLines:
  - "L\xE0 L\u1ED0P m\xE0 c\u1EE9 t\u01B0\u1EDFng m\xECnh hay. M\xE0y \u0111\u1EE3i
    \u0111\xF3! Tao s\u1EBD ph\u1EE5c th\xF9"
  firstFightPlayerLines:
  - "\u01A0 \u0111\xE1 n\xF3 \u0111i ch\u1EE9, sao ch\u1EA1y kh\xF4ng v\u1EADy?"
  firstFightLineDelaySeconds: 4
  banner: {fileID: 0}
  firstFightLineSeconds: 4
