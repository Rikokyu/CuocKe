MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 4231067701193549326}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5716f3bd98aefd04586b026effa0e4c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestNPC
  npcName: Co Lan
  quest: {fileID: 11400000, guid: dd4242b8f153bf44ebfef1632dfde082, type: 2}
  additionalQuests: []
  interactionDistance: 4
  interactKey: 101
  promptText: "Nh\u1EA5n E \u0111\u1EC3 n\xF3i chuy\u1EC7n v\u1EDBi Masha Da Den"
  requireFirstBattleLoss: 1
  requiredCompletedQuest: {fileID: 11400000, guid: 98783775d5747574381b5027f57adebb, type: 2}
  startedByStory: []
  storyPayAfterCompleted: {fileID: 0}
  payLaterLines:
  - "Ch\xE1u giao h\xE0ng xong r\u1ED3i \xE0? Gi\u1ECFi l\u1EAFm! Nh\u01B0ng lo xong
    chuy\u1EC7n v\u1EDBi th\u1EB1ng b\u1EA1n \u0111\xE3, r\u1ED3i quay l\u1EA1i \u0111\xE2y
    b\xE0 tr\u1EA3 c\xF4ng nh\xE9."
  alsoRequiredCompletedQuests:
  - {fileID: 11400000, guid: 9fdce12d520833149b877b8c24d6a202, type: 2}
  player: {fileID: 0}
  modelRoot: {fileID: 0}
  questManager: {fileID: 0}
  dialogue: {fileID: 0}
  prompt: {fileID: 0}
  offerLines:
  - "\u01A0 ch\xE0o em, qua \u0111\xE2y l\xE0m g\xEC.\n"
  - "N\u1EBFu m\xE0 mu\u1ED1n ki\u1EBFm th\xEC th\xEC \u0111\u01A1n gi\u1EA3n l\u1EAFm\n"
  - "Th\u1EED \u0111i nh\u1EB7t ve chai quanh l\xE0ng \u0111i. \u0110\u1EE7 {1} m\xF3n
    th\xEC quay l\u1EA1i \u0111\xE2y, t\xF4i s\u1EBD tr\u1EA3 c\xF4ng cho c\u1EADu."
  activeLines:
  - "Em m\u1EDBi nh\u1EB7t \u0111\u01B0\u1EE3c {0}/{1} m\xF3n th\xF4i b\xE9. L\u01B0\u1EDDi
    bi\u1EBFng th\xEC c\xF3 n\u1ECBt nhe. \u0110i nh\u1EB7t th\xEAm ve chai quanh
    l\xE0ng \u0111i!"
  readyLines:
  - "\u0110\u1EE7 {1} m\xF3n r\u1ED3i \xE0? Gi\u1ECFi l\u1EAFm! Ti\u1EC1n c\xF4ng
    c\u1EE7a b\xE9 l\xE0 {2} VN\u0110 n\xE8. C\xF3 c\u1EA7n g\xEC c\u1EE9 g\u1ECDi
    ch\u1ECB nh\xE1 babe"
  completedLines:
  - "C\u1EA3m \u01A1n c\u1EADu nh\xE9! C\u1EA7m ti\u1EC1n \u0111\xF3 v\u1EC1 \u0111i
    C\xF3 nh\u1EDB ch\u1ECB th\xEC qua \u0111\xE2y."
  idleLines:
  - "X\xF3m \u0110\xF4ng d\u1EA1o n\xE0y \u0111\xF4ng vui h\u1EB3n l\xEAn nh\u1EC9."
  acceptLabel: "Nh\u1EADn nhi\u1EC7m v\u1EE5"
  claimLabel: "Nh\u1EADn ti\u1EC1n c\xF4ng (+{2} VN\u0110)"
