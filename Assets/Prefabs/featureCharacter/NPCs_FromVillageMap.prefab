  keepButtonLabel: "Xin \xF4ng gi\u1EEF l\u1EA1i con g\xE0"
  agreeLines:
  - "Th\xF4i \u0111\u01B0\u1EE3c, ch\xE1u \u0111\xE3 xin v\u1EADy th\xEC \xF4ng chi\u1EC1u
