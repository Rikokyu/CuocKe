--- !u!114 &1336580107668969869
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3202384771163021530}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 709618d64535d294484833c35ecc702a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ChildhoodFriendBattleTaunt
  interactionDistance: 3
  interactKey: 101
  promptText: "Nh\u1EA5n E \u0111\u1EC3 n\xF3i chuy\u1EC7n v\u1EDBi B\u1EA1n th\xE2n"
  player: {fileID: 0}
  dialogue: {fileID: 0}
  prompt: {fileID: 0}
  questManager: {fileID: 0}
  questBattle: {fileID: 11400000, guid: 67499589fd8c04f499abc755095037db, type: 2}
  deliveryTarget: {fileID: 0}
  tauntDelaySeconds: 2.5
  challengeLines:
  - "\u01A0, th\u1EB1ng IT v\u1EC1 l\xE0ng r\u1ED3i \xE0? L\xE2u l\u1EAFm kh\xF4ng
    g\u1EB7p!"
  - "Tao m\u1EDBi quen nh\u1ECF kia xinh l\u1EAFm, c\xF3 c\u1EA7n tao gi\u1EDBi thi\u1EC7u
    cho kh\xF4ng"
  - "\u1EE6a m\xE0 con g\xE0 c\u1EE7a m\xECnh nh\xECn c\u0169ng ch\u1EAFc th\u1ECBt
    \u0111\u1EA5y"
  - "Th\u1EED s\u1EE9c v\u1EDBi g\xE0 c\u1EE7a tao xem sao? \u0110\u1EC3 l\xFAc n\xE0o
    r\u1EA3nh m\xECnh \u0111\u1EA5u m\u1ED9t tr\u1EADn!"
  acceptLabel: "Nh\u1EADn l\u1EDDi th\xE1ch \u0111\u1EA5u"
  needChickenLines:
  - "\u01A0, g\xE0 c\u1EE7a m\xE0y \u0111\xE2u? D\u1EAFt n\xF3 theo r\u1ED3i h\u1EB5ng
    n\xF3i chuy\u1EC7n th\xE1ch \u0111\u1EA5u!"
  fightingLines:
  - "\u0110ang \u0111\u1EA5u r\u1ED3i, nh\xECn \u0111i \u0111\xE2u \u0111\u1EA5y?!"
  afterLossLines:
  - "Hahaha, thua r\u1ED3i \u0111\xF3! B\u1EEFa n\xE0o t\xE1i \u0111\u1EA5u kh\xF4ng? "
  - "Kh\xF4ng d\xE1m choi l\xE0 d\u1EDF r\u1ED3i "
  - "M\xC0Y S\u1EE2 \xC0 "
  idleLines:
  - "G\xE0 m\xE0y c\xF2n y\u1EBFu l\u1EAFm. V\u1EC1 gi\xFAp \xF4ng b\xE0 \u0111i
    \u0111\xE3, r\u1ED3i t\xEDnh chuy\u1EC7n t\xE1i \u0111\u1EA5u. Tao ch\u1EDD \u0111\u1EA5y."
  playerSpeakerName: "T\xF4i"
  playerReplyLines:
  - "M\xE0y \u0111\u1EE3i \u0111\xF3! Tao s\u1EBD ph\u1EE5c th\xF9"
--- !u!114 &7650480498747591159
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3202384771163021530}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: ca50278103d45a342ad9f069dbbf8bf0, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RematchController
  questManager: {fileID: 0}
  dialogue: {fileID: 0}
  banner: {fileID: 0}
  rematchQuest: {fileID: 11400000, guid: 8acb6228d533dab49aa780129186f67e, type: 2}
  chickenStats: {fileID: 0}
  arenaStartDistance: 4
  victoryDialogueDelay: 2.5
  getUpDelay: 3
  getUpTimeout: 8
  idleStateName: ChickenIdle
  arenaRadius: 6
  guidanceReminderSeconds: 6
  guidanceMessage: "H\xE3y d\u1EABn g\xE0 \u0111\u1EBFn \u0111\u1EA5u tr\u01B0\u1EDDng
    \u0111\u1EC3 b\u1EAFt \u0111\u1EA7u tr\u1EADn t\xE1i \u0111\u1EA5u!"
  notReadyLines:
  - "G\xE0 m\xE0y m\u1EDBi t\u1EADp {0}/{1} bu\u1ED5i th\xF4i \xE0? Ch\u01B0a \u0111\u1EE7
    \u0111\xF4 \u0111\u1EC3 \u0111\u1EA5u v\u1EDBi tao \u0111\xE2u."
  - "Kh\xF4ng c\xF3 ti\u1EC1n th\xEC \u0111i nh\u1EB7t ve chai, giao h\xE0ng \u0111i.
    Mua th\u1EA3m t\u1EADp \u1EDF ch\u1EE3, r\u1ED3i nh\u1EDD hu\u1EA5n luy\u1EC7n
    vi\xEAn \u1EDF khu t\u1EADp luy\u1EC7n cho g\xE0."
  readyLines:
  - "\u1ED2, nh\xECn con g\xE0 m\xE0y kh\xE1c h\u1EB3n r\u1ED3i \u0111\u1EA5y. S\u1EB5n
    s\xE0ng t\xE1i \u0111\u1EA5u ch\u01B0a?"
  retryLines:
  - "Sao, ch\u01B0a ph\u1EE5c \xE0? T\u1EADp th\xEAm c\u0169ng \u0111\u01B0\u1EE3c,
    ho\u1EB7c \u0111\u1EA5u l\u1EA1i lu\xF4n!"
  rematchLabel: "T\xE1i \u0111\u1EA5u!"
  transformedLines:
  - "Khoan... g\xE0 m\xE0y sao t\u1EF1 d\u01B0ng to ra c\u1EA3 v\xF2ng th\u1EBF kia?
    M\xE0y cho n\xF3 \u0103n c\xE1i g\xEC v\u1EADy?"
  tournamentOpenLines:
  - "G\xE0 m\xE0y m\u1EA1nh l\xEAn th\u1EADt r\u1ED3i \u0111\u1EA5y. Nghe n\xF3i
    gi\u1EA3i l\xE0ng \u0111ang m\u1EDF, ch\u1ECB Ba v\u1EDBi ch\xFA T\u01B0 \u0111ang
    ch\u1EDD."
  - "H\u1EA1 \u0111\u01B0\u1EE3c c\u1EA3 hai ng\u01B0\u1EDDi \u0111\xF3 r\u1ED3i
    h\u1EB5ng quay l\u1EA1i n\xF3i chuy\u1EC7n v\u1EDBi tao."
  tournamentPartLines:
  - "Nghe n\xF3i m\xE0y h\u1EA1 \u0111\u01B0\u1EE3c {0}/{1} ng\u01B0\u1EDDi \u1EDF
    gi\u1EA3i l\xE0ng r\u1ED3i h\u1EA3? H\u1EA1 n\u1ED1t ng\u01B0\u1EDDi c\xF2n l\u1EA1i
    \u0111i, r\u1ED3i quay l\u1EA1i \u0111\xE2y."
  tournamentDoneLines:
  - "H\u1EA1 c\u1EA3 ch\u1ECB Ba l\u1EABn ch\xFA T\u01B0, l\u1EA5y \u0111\u1EE7 {0}
    huy ch\u01B0\u01A1ng r\u1ED3i c\u01A1 \xE0? G\xE0 m\xE0y gi\u1EDD kh\xF4ng ph\u1EA3i
    d\u1EA1ng v\u1EEBa \u0111\xE2u."
  - "\u0110\u01B0\u1EE3c r\u1ED3i. L\u1EA7n n\xE0y tao kh\xF4ng \u0111\xF9a n\u1EEFa."
  fightingLines:
  - "\u0110ang \u0111\u1EA5u r\u1ED3i, nh\xECn \u0111i \u0111\xE2u \u0111\u1EA5y?!"
  recoveringLines:
  - "\u0110\u1EE3i g\xE0 m\xE0y \u0111\u1EE9ng d\u1EADy \u0111\xE3 r\u1ED3i h\u1EB5ng
    n\xF3i chuy\u1EC7n."
  needChickenLines:
  - "G\xE0 c\u1EE7a m\xE0y \u0111\xE2u? D\u1EAFt n\xF3 theo r\u1ED3i h\u1EB5ng t\xE1i
    \u0111\u1EA5u!"
  wonLines:
  - "H\u1EA3?! Tao thua th\u1EADt \xE0... C\xF4ng nh\u1EADn g\xE0 m\xE0y kho\u1EBB
    th\u1EADt \u0111\u1EA5y."
  - "Nh\u01B0ng \u0111\u1EEBng t\u01B0\u1EDFng tao b\u1ECF cu\u1ED9c nh\xE9. C\xF2n
    l\xE2u m\u1EDBi xong!"
  startMessage: "Tr\u1EADn t\xE1i \u0111\u1EA5u b\u1EAFt \u0111\u1EA7u!"
  lostMessage: "Thua r\u1ED3i! Luy\u1EC7n th\xEAm r\u1ED3i n\xF3i chuy\u1EC7n v\u1EDBi
    b\u1EA1n \u0111\u1EC3 \u0111\u1EA5u l\u1EA1i."
