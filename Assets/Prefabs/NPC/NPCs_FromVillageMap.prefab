  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::GrandfatherChickenRescue
  interactionDistance: 3
  interactKey: 101
  promptText: "Nh\u1EA5n E \u0111\u1EC3 n\xF3i chuy\u1EC7n v\u1EDBi \xD4ng"
  player: {fileID: 0}
  dialogue: {fileID: 0}
  prompt: {fileID: 0}
  questManager: {fileID: 0}
  questArrive: {fileID: 11400000, guid: 47f6fd93c10dc4540819459e029f7b18, type: 2}
  questRescue: {fileID: 11400000, guid: bc723f5358c8b9d42b39cffae239a86d, type: 2}
  chicken: {fileID: 0}
  greetLines:
  - "A, ch\xE1u v\u1EC1 r\u1ED3i \u0111\u1EA5y \xE0! L\xE2u l\u1EAFm m\u1EDBi th\u1EA5y
    m\u1EB7t."
  - "\u0110\u1EC3 \xF4ng m\u1EEBng th\u1ECBt con g\xE0 cho ch\xFAng ta c\xF9ng \u0103n
    nh\xE9!"
  keepButtonLabel: "Xin \xF4ng gi\u1EEF l\u1EA1i con g\xE0"
  agreeLines:
  - "Th\xF4i \u0111\u01B0\u1EE3c, ch\xE1u \u0111\xE3 xin v\u1EADy th\xEC \xF4ng chi\u1EC1u
    ch\xE1u. Con g\xE0 l\xE0 c\u1EE7a ch\xE1u r\u1ED3i \u0111\u1EA5y!"
  - "N\xF3 \u0111ang t\u1EC9nh d\u1EADy k\xECa. Ch\u0103m n\xF3 cho t\u1EED t\u1EBF
    nh\xE9."
  idleLines:
  - "Th\xF4i \u0111\u01B0\u1EE3c, ch\xE1u \u0111\xE3 xin v\u1EADy th\xEC \xF4ng chi\u1EC1u
    ch\xE1u, gi\u1EEF l\u1EA5y m\xE0 nu\xF4i."
  - "Con g\xE0 \u0111\xF3 \xF4ng th\u1EA5y l\u1EA1 l\u1EAFm, ch\xE1u ch\u0103m s\xF3c
    n\xF3 c\u1EA9n th\u1EADn nh\xE9."
