MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6845194556641725350}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5716f3bd98aefd04586b026effa0e4c6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::QuestNPC
  npcName: "B\xE0"
  quest: {fileID: 11400000, guid: b97efb725b0ba6442b9476056843122b, type: 2}
  additionalQuests:
  - {fileID: 11400000, guid: 9fdce12d520833149b877b8c24d6a202, type: 2}
  interactionDistance: 3
  interactKey: 101
  promptText: "Nh\u1EA5n E \u0111\u1EC3 n\xF3i chuy\u1EC7n v\u1EDBi Ba"
  requireFirstBattleLoss: 1
  player: {fileID: 0}
  modelRoot: {fileID: 0}
  questManager: {fileID: 0}
  dialogue: {fileID: 0}
  prompt: {fileID: 0}
  offerLines:
  - "G\xE0 c\u1EE7a c\u1EADu c\xF2n y\u1EBFu l\u1EAFm. Mu\u1ED1n hu\u1EA5n luy\u1EC7n
    n\xF3 th\xEC ph\u1EA3i c\xF3 ti\u1EC1n tr\u01B0\u1EDBc \u0111\xE3."
  - "Th\u1EED \u0111i nh\u1EB7t ve chai quanh l\xE0ng \u0111i. \u0110\u1EE7 {1} m\xF3n
    th\xEC quay l\u1EA1i \u0111\xE2y, t\xF4i s\u1EBD tr\u1EA3 c\xF4ng cho c\u1EADu."
  activeLines:
  - "C\u1EADu m\u1EDBi nh\u1EB7t \u0111\u01B0\u1EE3c {0}/{1} m\xF3n th\xF4i. \u0110i
    nh\u1EB7t th\xEAm ve chai quanh l\xE0ng \u0111i!"
  readyLines:
  - "\u0110\u1EE7 {1} m\xF3n r\u1ED3i \xE0? Gi\u1ECFi l\u1EAFm! Ti\u1EC1n c\xF4ng
    c\u1EE7a c\u1EADu l\xE0 {2} ti\u1EC1n."
  completedLines:
  - "C\u1EA3m \u01A1n c\u1EADu nh\xE9! C\u1EA7m ti\u1EC1n \u0111\xF3 m\xE0 lo cho
    con g\xE0 \u0111i."
  idleLines:
  - "Ch\xE1u v\u1EC1 r\u1ED3i \xE0, \u0111\u1EC3 b\xE0 n\u1EA5u cho b\xE1t c\u01A1m
    n\xF3ng nh\xE9."
  - "Con g\xE0 \u0111\xF3 \xF4ng ch\xE1u \u0111\u1ECBnh l\xE0m th\u1ECBt \u0111\u1EA5y,
    ch\xE1u xin \xF4ng gi\u1EEF l\u1EA1i m\xE0 nu\xF4i \u0111i."
  acceptLabel: "Nh\u1EADn nhi\u1EC7m v\u1EE5"
  claimLabel: "Nh\u1EADn ti\u1EC1n c\xF4ng (+{2})"
