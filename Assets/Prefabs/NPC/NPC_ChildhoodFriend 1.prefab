  m_EditorClassIdentifier: Assembly-CSharp::FinalBossController
  questManager: {fileID: 0}
  dialogue: {fileID: 0}
  banner: {fileID: 0}
  finalBossQuest: {fileID: 11400000, guid: 9fe81f85d83cbb34e82c0985ee5a1537, type: 2}
  tournamentManager: {fileID: 0}
  requiredMedals: 2
  bossMaxHealth: 330
  bossDamage: 34
  arenaStartDistance: 4
  victoryDialogueDelay: 2.5
  getUpDelay: 3
  getUpTimeout: 8
  idleStateName: ChickenIdle
  arenaRadius: 6
  guidanceReminderSeconds: 6
  guidanceMessage: "H\xE3y d\u1EABn g\xE0 \u0111\u1EBFn \u0111\u1EA5u tr\u01B0\u1EDDng
    \u0111\u1EC3 b\u1EAFt \u0111\u1EA7u tr\u1EADn ph\u1EE5c th\xF9!"
  challengeLines:
  - "M\xE0y h\u1EA1 \u0111\u01B0\u1EE3c c\u1EA3 ch\u1ECB Ba l\u1EABn ch\xFA T\u01B0
    r\u1ED3i \xE0? Kh\xF4ng ng\u1EDD \u0111\u1EA5y."
  - "Nh\u01B0ng \u0111\u1EEBng t\u01B0\u1EDFng th\u1EBF l\xE0 xong. L\u1EA7n n\xE0y
    tao s\u1EBD kh\xF4ng nh\u1EB9 tay \u0111\xE2u."
  - "M\xC0Y S\u1EE2 \xC0? \u0110\u1EA5u th\u1EADt m\u1ED9t tr\u1EADn cho ra l\u1EBD
    \u0111i!"
  acceptLabel: "Ph\u1EE5c th\xF9!"
  retryLines:
  - "H\u1EA3, ch\u01B0a ph\u1EE5c \xE0? L\u1EA1i \u0111\xE2y, tao ch\u1EDD s\u1EB5n
    r\u1ED3i."
  fightingLines:
  - "\u0110ang \u0111\u1EA5u r\u1ED3i, nh\xECn \u0111i \u0111\xE2u \u0111\u1EA5y?!"
  recoveringLines:
  - "\u0110\u1EE3i g\xE0 m\xE0y \u0111\u1EE9ng d\u1EADy \u0111\xE3 r\u1ED3i h\u1EB5ng
    n\xF3i chuy\u1EC7n."
  needChickenLines:
  - "G\xE0 c\u1EE7a m\xE0y \u0111\xE2u? D\u1EAFt n\xF3 theo r\u1ED3i h\u1EB5ng \u0111\u1EA5u!"
  wonLines:
  - "...Tao thua th\u1EADt r\u1ED3i. G\xE0 c\u1EE7a m\xE0y gi\u1EDD kh\xF4ng c\xF2n
    g\xEC \u0111\u1EC3 ch\xEA n\u1EEFa."
  - "Th\xF4i \u0111\u01B0\u1EE3c, tao c\xF4ng nh\u1EADn m\xE0y ngon. D\u1EAFt g\xE0
    v\u1EC1 nh\xE0 \xF4ng b\xE0 m\xE0 khoe \u0111i, \u0111\xE1ng l\u1EAFm."
  afterWonIdleLines:
  - "Haha, ngh\u0129 l\u1EA1i v\u1EABn ph\u1EE5c m\xE0y v\u1EDBi con g\xE0 \u0111\xF3
    \u0111\u1EA5y."
  startMessage: "Tr\u1EADn ph\u1EE5c th\xF9 cu\u1ED1i c\xF9ng b\u1EAFt \u0111\u1EA7u!"
  lostMessage: "Thua r\u1ED3i! Luy\u1EC7n th\xEAm r\u1ED3i quay l\u1EA1i \u0111\u1EA5u
    ti\u1EBFp."
  winMessage: "Chi\u1EBFn th\u1EAFng! B\u1EA1n \u0111\xE3 \u0111\xE1nh b\u1EA1i b\u1EA1n
    th\xE2n c\u0169!"
